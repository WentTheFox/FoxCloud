[Unit]
Description=FoxCloud sync daemon
Documentation=https://github.com/WentTheFox/FoxCloud
# The sync passes and the mount need the network and, for the first pass, a
# settled system. A user unit cannot order itself after the system's
# network-online.target, so the waits are in ExecStartPre below.

[Service]
Type=simple
# Hold until boot has finished (blocks, no polling). The leading "-" ignores
# the exit code: a "degraded" system has still finished booting. The extra
# delay before the first pass is [daemon] startup_delay in the config.
ExecStartPre=-/usr/bin/systemctl --system is-system-running --wait
# Hold until NetworkManager reports a connection (blocks on its signals, up to
# 60 s). Ignored when NetworkManager is not installed or never connects; the
# mount and the passes then retry on their own.
ExecStartPre=-/usr/bin/nm-online --quiet --timeout=60
# Optional file with FOXCLOUD_CONFIG=/path/to/config.toml
EnvironmentFile=-%E/foxcloud/env
ExecStart=%h/.local/bin/foxcloudd
# Also how auto-updates restart the daemon: it exits with status 75 after
# installing, which counts as a failure here.
Restart=on-failure
RestartSec=30
# Be nice to the desktop while syncing.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
