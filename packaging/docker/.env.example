RCD_USER=phone
RCD_PASS=change-me
FOXCLOUD_CRYPT_KEY=the-master-key-from-the-desktop-keyring
# Multi-line values: double quotes with \n escapes in a .env file (or set them in your orchestrator).
FOXCLOUD_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# From `ssh-keyscan -p 23 <host>` (ALL key types it prints, not just ed25519:
# rclone fails with "knownhosts: key mismatch" if the server presents a type
# that is missing here); verify the fingerprints first. Separate lines with \n.
FOXCLOUD_KNOWN_HOSTS="[uXXXXXX.your-storagebox.de]:23 ssh-ed25519 AAAA..."
